# ==========================================================================
# Configuração do Flow Metrics — copie este arquivo para ".env" e preencha.
# ==========================================================================

# --- Conexão com o Jira Cloud ---
JIRA_BASE_URL=https://medcel.atlassian.net
JIRA_EMAIL=seu-email@empresa.com
# Gere um token em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=seu_api_token_aqui

# --- Consulta (JQL) ---
# Se comentado, usa a JQL original extraída da planilha (aba "About").
JIRA_JQL=project IN (LEG, COREX, APP, "DESC", BAU, CONV, APR, PLAT) AND type IN (...) AND labels IN (...) ORDER BY created DESC

# --- Custom fields (IDs específicos da SUA instância!) ---
# Rode "npm run discover:fields" para descobrir os IDs corretos e cole abaixo.
# Os valores abaixo são apenas PADRÕES comuns do Jira Cloud e provavelmente
# precisam ser ajustados.
JIRA_FIELD_TEAM=customfield_10001
JIRA_FIELD_STORY_POINTS=customfield_10016
JIRA_FIELD_START_DATE=customfield_10015
JIRA_FIELD_ACTUAL_START=customfield_10257
JIRA_FIELD_ACTUAL_END=customfield_10258
JIRA_FIELD_SPRINT=customfield_10113
JIRA_FIELD_BCP=customfield_12377
JIRA_FIELD_BLOCK_REASON=customfield_11638

# --- Servidor ---
PORT=3000

# --- Cache (ms) — evita bater na API do Jira a cada request do navegador ---
CACHE_TTL_MS=300000

# --- Avançado ---
# Endpoint de busca. O padrão é o endpoint moderno de JQL do Jira Cloud.
# JIRA_SEARCH_PATH=/rest/api/3/search/jql
# JIRA_PAGE_SIZE=100

# Cache persistente / atualização em background
CACHE_FILE_PATH=cache/dataset.json
REFRESH_INTERVAL_MS=3600000
