{
  "name": "flow-metrics",
  "version": "1.0.0",
  "description": "Dashboard de Flow Metrics (SAFe) alimentado diretamente pela API do Jira, em Clean Architecture + SOLID.",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:frontend",
    "build:frontend": "tsc -p tsconfig.frontend.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "prestart": "npm run build",
    "start": "node dist/src/main.js",
    "predev": "npm run build",
    "dev": "node dist/scripts/dev.js",
    "build:amplify": "npm run build && node dist/scripts/build-amplify.js",
    "prediscover:fields": "npm run build",
    "discover:fields": "node dist/scripts/discover-fields.js",
    "test:transform": "node dist/test/transform.spec.js",
    "test:sprint": "node dist/test/sprint-history.spec.js",
    "test:velocity": "node dist/test/velocity.spec.js",
    "test:amplify": "node dist/test/amplify.spec.js",
    "test:progressive": "node dist/test/progressive.spec.js",
    "test:pi": "node dist/test/pi-tracking.spec.js",
    "test:pi-drill": "node dist/test/pi-progress-drill.spec.js",
    "test:pi-vs": "node dist/test/pi-value-stream.spec.js",
    "test:delivery": "node dist/test/sprint-delivery.spec.js",
    "test:filtros": "node dist/test/filtros.spec.js",
    "test:bloqueios": "node dist/test/bloqueios.spec.js",
    "test:drawer": "node dist/test/drawer-status.spec.js",
    "test:status-time": "node dist/test/status-time.spec.js",
    "test:status-time-view": "node dist/test/status-time-view.spec.js",
    "test:dependencias": "node dist/test/dependencias.spec.js",
    "test:wip": "node dist/test/wip-kpis.spec.js",
    "test:sp-tempo": "node dist/test/sp-tempo-por-sp.spec.js",
    "test:flow-medidas": "node dist/test/flow-medidas.spec.js",
    "test:burndown": "node dist/test/sprint-burndown.spec.js",
    "test:completude": "node dist/test/sprint-completude.spec.js",
    "pretest": "npm run build",
    "test": "npm run test:transform && npm run test:sprint && npm run test:velocity && npm run test:progressive && npm run test:pi && npm run test:pi-drill && npm run test:pi-vs && npm run test:delivery && npm run test:filtros && npm run test:bloqueios && npm run test:drawer && npm run test:status-time && npm run test:status-time-view && npm run test:dependencias && npm run test:wip && npm run test:sp-tempo && npm run test:flow-medidas && npm run test:burndown && npm run test:completude && npm run test:amplify"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.0"
  }
}
