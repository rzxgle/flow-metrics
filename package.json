{
  "name": "jira-flow-metrics",
  "version": "1.0.0",
  "description": "Dashboard de Flow Metrics (SAFe) alimentado diretamente pela API do Jira, em Clean Architecture + SOLID.",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "build:amplify": "node scripts/build-amplify.js",
    "discover:fields": "node scripts/discover-fields.js",
    "test:transform": "node test/transform.spec.js",
    "test:sprint": "node test/sprint-history.spec.js",
    "test:velocity": "node test/velocity.spec.js",
    "test:amplify": "node test/amplify.spec.js",
    "test:progressive": "node test/progressive.spec.js",
    "test:pi": "node test/pi-tracking.spec.js",
    "test:delivery": "node test/sprint-delivery.spec.js",
    "test:filtros": "node test/filtros.spec.js",
    "test": "npm run test:transform && npm run test:sprint && npm run test:velocity && npm run test:progressive && npm run test:pi && npm run test:delivery && npm run test:filtros && npm run test:amplify"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}

