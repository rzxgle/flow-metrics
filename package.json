{
  "name": "jira-flow-metrics",
  "version": "1.0.0",
  "description": "Dashboard de Flow Metrics (SAFe) alimentado diretamente pela API do Jira, em Clean Architecture + SOLID.",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "npm run build",
    "start": "node dist/src/main.js",
    "predev": "npm run build",
    "dev": "concurrently -k \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/src/main.js\"",
    "build:amplify": "npm run build && node scripts/build-amplify.js",
    "discover:fields": "node scripts/discover-fields.js",
    "test:transform": "node test/transform.spec.js",
    "test:sprint": "node test/sprint-history.spec.js",
    "test:velocity": "node test/velocity.spec.js",
    "test:amplify": "node test/amplify.spec.js",
    "test:progressive": "node test/progressive.spec.js",
    "test:pi": "node test/pi-tracking.spec.js",
    "test:pi-drill": "node test/pi-progress-drill.spec.js",
    "test:pi-vs": "node test/pi-value-stream.spec.js",
    "test:delivery": "node test/sprint-delivery.spec.js",
    "test:filtros": "node test/filtros.spec.js",
    "test:bloqueios": "node test/bloqueios.spec.js",
    "test:drawer": "node test/drawer-status.spec.js",
    "test:status-time": "node test/status-time.spec.js",
    "test:status-time-view": "node test/status-time-view.spec.js",
    "test:dependencias": "node test/dependencias.spec.js",
    "test:wip": "node test/wip-kpis.spec.js",
    "test:sp-tempo": "node test/sp-tempo-por-sp.spec.js",
    "test:flow-medidas": "node test/flow-medidas.spec.js",
    "test:burndown": "node test/sprint-burndown.spec.js",
    "test:completude": "node test/sprint-completude.spec.js",
    "pretest": "npm run build",
    "test": "npm run test:transform && npm run test:sprint && npm run test:velocity && npm run test:progressive && npm run test:pi && npm run test:pi-drill && npm run test:pi-vs && npm run test:delivery && npm run test:filtros && npm run test:bloqueios && npm run test:drawer && npm run test:status-time && npm run test:status-time-view && npm run test:dependencias && npm run test:wip && npm run test:sp-tempo && npm run test:flow-medidas && npm run test:burndown && npm run test:completude && npm run test:amplify"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.0"
  }
}
